  template <typename VecVar, typename VecI,
            stan::require_vector_t<VecVar>* = nullptr,
            stan::require_vector_like_vt<std::is_integral, VecI>* = nullptr>
  inline void
  unconstrain_array_impl(const VecVar& params_r__, const VecI& params_i__,
                         VecVar& vars__, std::ostream* pstream__ = nullptr) const {
    using local_scalar_t__ = double;
    stan::io::deserializer<local_scalar_t__> in__(params_r__, params_i__);
    stan::io::serializer<local_scalar_t__> out__(vars__);
    int current_statement__ = 0;
    // suppress unused var warning
    (void) current_statement__;
    local_scalar_t__ DUMMY_VAR__(std::numeric_limits<double>::quiet_NaN());
    // suppress unused var warning
    (void) DUMMY_VAR__;
    try {
      std::vector<local_scalar_t__> theta =
        std::vector<local_scalar_t__>(2, DUMMY_VAR__);
      current_statement__ = 1;
      stan::model::assign(theta, in__.read<std::vector<local_scalar_t__>>(2),
        "assigning variable theta");
      out__.write_free_lb(0, theta);
      std::vector<std::vector<local_scalar_t__>> theta_t =
        std::vector<std::vector<local_scalar_t__>>(nt,
          std::vector<local_scalar_t__>(2, DUMMY_VAR__));
      current_statement__ = 2;
      for (int sym1__ = 1; sym1__ <= 2; ++sym1__) {
        for (int sym2__ = 1; sym2__ <= nt; ++sym2__) {
          current_statement__ = 2;
          theta_t[(sym2__ - 1)][(sym1__ -
            1)] = in__.read<local_scalar_t__>();
        }
      }
      out__.write_free_lb(0, theta_t);
      std::vector<local_scalar_t__> biovar =
        std::vector<local_scalar_t__>(2, DUMMY_VAR__);
      current_statement__ = 3;
      stan::model::assign(biovar,
        in__.read<std::vector<local_scalar_t__>>(2),
        "assigning variable biovar");
      out__.write_free_lb(0, biovar);
      std::vector<local_scalar_t__> tlag =
        std::vector<local_scalar_t__>(2, DUMMY_VAR__);
      current_statement__ = 4;
      stan::model::assign(tlag, in__.read<std::vector<local_scalar_t__>>(2),
        "assigning variable tlag");
      out__.write_free_lb(0, tlag);
      Eigen::Matrix<local_scalar_t__,-1,1> tau =
        Eigen::Matrix<local_scalar_t__,-1,1>::Constant(1, DUMMY_VAR__);
      current_statement__ = 5;
      stan::model::assign(tau,
        in__.read<Eigen::Matrix<local_scalar_t__,-1,1>>(1),
        "assigning variable tau");
      out__.write_free_lb(0, tau);
      Eigen::Matrix<local_scalar_t__,-1,1> y_hist =
        Eigen::Matrix<local_scalar_t__,-1,1>::Constant(2, DUMMY_VAR__);
      current_statement__ = 6;
      stan::model::assign(y_hist,
        in__.read<Eigen::Matrix<local_scalar_t__,-1,1>>(2),
        "assigning variable y_hist");
      out__.write_free_lb(0, y_hist);
    } catch (const std::exception& e) {
      stan::lang::rethrow_located(e, locations_array__[current_statement__]);
    }
  }
  template <typename VecVar, stan::require_vector_t<VecVar>* = nullptr>
  inline void
  transform_inits_impl(const stan::io::var_context& context__, VecVar&
                       vars__, std::ostream* pstream__ = nullptr) const {
    using local_scalar_t__ = double;
    stan::io::serializer<local_scalar_t__> out__(vars__);
    int current_statement__ = 0;
    // suppress unused var warning
    (void) current_statement__;
    local_scalar_t__ DUMMY_VAR__(std::numeric_limits<double>::quiet_NaN());
    // suppress unused var warning
    (void) DUMMY_VAR__;
    try {
      current_statement__ = 1;
      context__.validate_dims("parameter initialization", "theta", "double",
        std::vector<size_t>{static_cast<size_t>(2)});
      current_statement__ = 2;
      context__.validate_dims("parameter initialization", "theta_t",
        "double",
        std::vector<size_t>{static_cast<size_t>(nt), static_cast<size_t>(2)});
      current_statement__ = 3;
      context__.validate_dims("parameter initialization", "biovar", "double",
        std::vector<size_t>{static_cast<size_t>(2)});
      current_statement__ = 4;
      context__.validate_dims("parameter initialization", "tlag", "double",
        std::vector<size_t>{static_cast<size_t>(2)});
      current_statement__ = 5;
      context__.validate_dims("parameter initialization", "tau", "double",
        std::vector<size_t>{static_cast<size_t>(1)});
      current_statement__ = 6;
      context__.validate_dims("parameter initialization", "y_hist", "double",
        std::vector<size_t>{static_cast<size_t>(2)});
      int pos__ = std::numeric_limits<int>::min();
      pos__ = 1;
      std::vector<local_scalar_t__> theta =
        std::vector<local_scalar_t__>(2, DUMMY_VAR__);
      current_statement__ = 1;
      theta = context__.vals_r("theta");
      out__.write_free_lb(0, theta);
      std::vector<std::vector<local_scalar_t__>> theta_t =
        std::vector<std::vector<local_scalar_t__>>(nt,
          std::vector<local_scalar_t__>(2, DUMMY_VAR__));
      {
        std::vector<local_scalar_t__> theta_t_flat__;
        current_statement__ = 2;
        theta_t_flat__ = context__.vals_r("theta_t");
        pos__ = 1;
        for (int sym1__ = 1; sym1__ <= 2; ++sym1__) {
          for (int sym2__ = 1; sym2__ <= nt; ++sym2__) {
            stan::model::assign(theta_t, theta_t_flat__[(pos__ - 1)],
              "assigning variable theta_t", stan::model::index_uni(sym2__),
              stan::model::index_uni(sym1__));
            pos__ = (pos__ + 1);
          }
        }
      }
      out__.write_free_lb(0, theta_t);
      std::vector<local_scalar_t__> biovar =
        std::vector<local_scalar_t__>(2, DUMMY_VAR__);
      current_statement__ = 3;
      biovar = context__.vals_r("biovar");
      out__.write_free_lb(0, biovar);
      std::vector<local_scalar_t__> tlag =
        std::vector<local_scalar_t__>(2, DUMMY_VAR__);
      current_statement__ = 4;
      tlag = context__.vals_r("tlag");
      out__.write_free_lb(0, tlag);
      Eigen::Matrix<local_scalar_t__,-1,1> tau =
        Eigen::Matrix<local_scalar_t__,-1,1>::Constant(1, DUMMY_VAR__);
      {
        std::vector<local_scalar_t__> tau_flat__;
        current_statement__ = 5;
        tau_flat__ = context__.vals_r("tau");
        pos__ = 1;
        for (int sym1__ = 1; sym1__ <= 1; ++sym1__) {
          stan::model::assign(tau, tau_flat__[(pos__ - 1)],
            "assigning variable tau", stan::model::index_uni(sym1__));
          pos__ = (pos__ + 1);
        }
      }
      out__.write_free_lb(0, tau);
      Eigen::Matrix<local_scalar_t__,-1,1> y_hist =
        Eigen::Matrix<local_scalar_t__,-1,1>::Constant(2, DUMMY_VAR__);
      {
        std::vector<local_scalar_t__> y_hist_flat__;
        current_statement__ = 6;
        y_hist_flat__ = context__.vals_r("y_hist");
        pos__ = 1;
        for (int sym1__ = 1; sym1__ <= 2; ++sym1__) {
          stan::model::assign(y_hist, y_hist_flat__[(pos__ - 1)],
            "assigning variable y_hist", stan::model::index_uni(sym1__));
          pos__ = (pos__ + 1);
        }
      }
      out__.write_free_lb(0, y_hist);
    } catch (const std::exception& e) {
      stan::lang::rethrow_located(e, locations_array__[current_statement__]);
    }
  }
  inline void
  get_param_names(std::vector<std::string>& names__, const bool
                  emit_transformed_parameters__ = true, const bool
                  emit_generated_quantities__ = true) const {
    names__ = std::vector<std::string>{"theta", "theta_t", "biovar", "tlag",
                "tau", "y_hist"};
    if (emit_transformed_parameters__) {
      std::vector<std::string> temp{"x", "x_full"};
      names__.reserve(names__.size() + temp.size());
      names__.insert(names__.end(), temp.begin(), temp.end());
    }
    if (emit_generated_quantities__) {}
  }
  inline void
  get_dims(std::vector<std::vector<size_t>>& dimss__, const bool
           emit_transformed_parameters__ = true, const bool
           emit_generated_quantities__ = true) const {
    dimss__ = std::vector<std::vector<size_t>>{std::vector<size_t>{static_cast<
                                                                    size_t>(2)},
                std::vector<size_t>{static_cast<size_t>(nt),
                  static_cast<size_t>(2)},
                std::vector<size_t>{static_cast<size_t>(2)},
                std::vector<size_t>{static_cast<size_t>(2)},
                std::vector<size_t>{static_cast<size_t>(1)},
                std::vector<size_t>{static_cast<size_t>(2)}};
    if (emit_transformed_parameters__) {
      std::vector<std::vector<size_t>>
        temp{std::vector<size_t>{static_cast<size_t>(2),
               static_cast<size_t>(nt)},
             std::vector<size_t>{static_cast<size_t>(2),
               static_cast<size_t>(nt)}};
      dimss__.reserve(dimss__.size() + temp.size());
      dimss__.insert(dimss__.end(), temp.begin(), temp.end());
    }
    if (emit_generated_quantities__) {}
  }
  inline void
  constrained_param_names(std::vector<std::string>& param_names__, bool
                          emit_transformed_parameters__ = true, bool
                          emit_generated_quantities__ = true) const final {
    for (int sym1__ = 1; sym1__ <= 2; ++sym1__) {
      param_names__.emplace_back(std::string() + "theta" + '.' +
        std::to_string(sym1__));
    }
    for (int sym1__ = 1; sym1__ <= 2; ++sym1__) {
      for (int sym2__ = 1; sym2__ <= nt; ++sym2__) {
        param_names__.emplace_back(std::string() + "theta_t" + '.' +
          std::to_string(sym2__) + '.' + std::to_string(sym1__));
      }
    }
    for (int sym1__ = 1; sym1__ <= 2; ++sym1__) {
      param_names__.emplace_back(std::string() + "biovar" + '.' +
        std::to_string(sym1__));
    }
    for (int sym1__ = 1; sym1__ <= 2; ++sym1__) {
      param_names__.emplace_back(std::string() + "tlag" + '.' +
        std::to_string(sym1__));
    }
    for (int sym1__ = 1; sym1__ <= 1; ++sym1__) {
      param_names__.emplace_back(std::string() + "tau" + '.' +
        std::to_string(sym1__));
    }
    for (int sym1__ = 1; sym1__ <= 2; ++sym1__) {
      param_names__.emplace_back(std::string() + "y_hist" + '.' +
        std::to_string(sym1__));
    }
    if (emit_transformed_parameters__) {
      for (int sym1__ = 1; sym1__ <= nt; ++sym1__) {
        for (int sym2__ = 1; sym2__ <= 2; ++sym2__) {
          param_names__.emplace_back(std::string() + "x" + '.' +
            std::to_string(sym2__) + '.' + std::to_string(sym1__));
        }
      }
      for (int sym1__ = 1; sym1__ <= nt; ++sym1__) {
        for (int sym2__ = 1; sym2__ <= 2; ++sym2__) {
          param_names__.emplace_back(std::string() + "x_full" + '.' +
            std::to_string(sym2__) + '.' + std::to_string(sym1__));
        }
      }
    }
    if (emit_generated_quantities__) {}
  }
